task execute pe_file=""
  describe Execute a Windows PE using the default staged container flow
  shell_lang bash
  shell |
    set -euo pipefail
    MODULE_DIR="$(cd "$(dirname "${PFY_FILE_PATH}")" && pwd)"
    pf "$MODULE_DIR/multi-exec/Pfyfile.pe-execution.pf" pe-execute pe_file="${pe_file}"
end

