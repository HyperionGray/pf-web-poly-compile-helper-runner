# PE execution module
# Access via: pf pe <task>

task usage
  describe Show staged PE module commands and host file behavior
  shell echo "PE module entrypoints:"
  shell echo "  pf pe install                                # Install/verify PE module prerequisites"
  shell echo "  pf pe build-all                              # Build the staged PE/VM images"
  shell echo "  pf pe execute pe_file=/path/to/app.exe       # Run a Windows PE with explicit host input/output mounts"
  shell echo "  pf pe execute-reactos pe_file=/path/to/app.exe"
  shell echo "  pf pe execute-nano pe_file=/path/to/app.exe"
  shell echo "  pf pe setup-vmkit                            # Prepare the VMKit-based runner"
  shell echo "  pf pe run-vmkit pe=/path/to/app.exe          # Run via VMKit passthrough"
  shell echo "  pf pe setup-reactos                          # Download/setup ReactOS assets"
  shell echo "  pf pe run-reactos pe=/path/to/app.exe        # Run via the ReactOS flow"
  shell echo "  pf pe execute-macos binary_file=/path/to/bin # Run a macOS binary in the staged QEMU flow"
  shell echo ""
  shell echo "Notes:"
  shell echo "  - The staged PE execution tasks mount the specific host input path plus artifact/output directories."
  shell echo "  - This module is intentionally standalone and does not leak always-available/root tasks into its listing."
end
task install
  describe Install/verify PE module prerequisites
  shell pf "$PFY_FILE_PATH" install-tools
end

task install-tools
  describe Install or verify PE module prerequisites (VMKit and ReactOS assets)
  shell pf "$PFY_FILE_PATH" setup-vmkit
  shell pf "$PFY_FILE_PATH" setup-reactos
end

task build-all
  describe Build the staged PE module images (Windows, ReactOS, macOS, VMKit)
  shell pf "$PFY_FILE_PATH" build-windows-server
  shell pf "$PFY_FILE_PATH" build-windows-nano
  shell pf "$PFY_FILE_PATH" build-reactos
  shell pf "$PFY_FILE_PATH" build-macos-qemu
  shell pf "$PFY_FILE_PATH" build-vmkit
end

task build-windows-server
  describe Build the Windows Server Core image used by the staged PE module
  shell_lang bash
  shell |
    set -euo pipefail
    MODULE_DIR="$(cd "$(dirname "${PFY_FILE_PATH}")" && pwd)"
    pf "$MODULE_DIR/multi-exec/Pfyfile.pe-execution.pf" pe-build-windows-server
end

task build-windows-nano
