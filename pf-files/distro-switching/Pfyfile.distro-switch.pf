# Distro Container Management Tasks
# Wrapper tasks around tools/distro-container-manager.mjs

task distro-init
  describe Initialize distro artifact directories (~/.pf/distros by default)
  shell_lang bash
  shell set -euo pipefail; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; node "$ROOT/tools/distro-container-manager.mjs" init
end

task distro-build
  describe Build distro container images (all, or distro=<fedora|rhel|centos|arch|opensuse|freebsd>)
  shell_lang bash
  shell set -euo pipefail; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; node "$ROOT/tools/distro-container-manager.mjs" build ${distro:-}
end

task distro-install distro="" packages=""
  describe Install packages from a specific distro container
  shell_lang bash
  shell set -euo pipefail; distro="${distro:-}"; packages="${packages:-}"; if [ -z "$distro" ] || [ -z "$packages" ]; then echo "Usage: pf distro-install distro=<fedora|rhel|centos|arch|opensuse|freebsd> packages=\\\"vim htop\\\""; exit 1; fi; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; set -- ${packages}; if [ $# -eq 0 ]; then echo "No packages provided after parsing"; exit 1; fi; node "$ROOT/tools/distro-container-manager.mjs" install "$distro" "$@"
end

task distro-switch distro=""
  describe Switch active distro (isolated view) for PATH selection
  shell_lang bash
  shell set -euo pipefail; distro="${distro:-}"; if [ -z "$distro" ]; then echo "Usage: pf distro-switch distro=<fedora|rhel|centos|arch|opensuse|freebsd>"; exit 1; fi; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; node "$ROOT/tools/distro-container-manager.mjs" switch "$distro"
end

task distro-view mode=""
  describe Set view mode: mode=<unified|isolated>
  shell_lang bash
  shell set -euo pipefail; mode="${mode:-}"; if [ -z "$mode" ]; then echo "Usage: pf distro-view mode=<unified|isolated>"; exit 1; fi; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; node "$ROOT/tools/distro-container-manager.mjs" view "$mode"
end

task distro-status
  describe Show distro container manager status
  shell_lang bash
  shell set -euo pipefail; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; node "$ROOT/tools/distro-container-manager.mjs" status
end

task distro-cleanup artifacts="false"
  describe Remove distro container images (and optionally artifacts=true)
  shell_lang bash
  shell set -euo pipefail; artifacts="${artifacts:-false}"; ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"; [ ! -f "$ROOT/tools/distro-container-manager.mjs" ] && ROOT="$(pwd -P)"; if [ "$artifacts" = "true" ]; then node "$ROOT/tools/distro-container-manager.mjs" cleanup --artifacts; else node "$ROOT/tools/distro-container-manager.mjs" cleanup; fi
end
