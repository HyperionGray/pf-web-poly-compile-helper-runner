# ---------------------------------------------------------------------------
# Quickstart samples (safe, local)
# ---------------------------------------------------------------------------

# Explicit language blocks (default_lang is flaky in this runner build)
task quickstart-hello [alias hello]
  describe Minimal example using explicit python command
  shell python3 -c "print('Hello from pf quickstart!'); import platform; print('Platform:', platform.system())"
end

task quickstart-bash
  describe Switch back to bash for implicit lines
  shell echo "Hi from bash"
  shell ls -1
end

# ---------------------------------------------------------------------------
# Web + API tasks
# ---------------------------------------------------------------------------

task web-dev
  describe Start development server with REST API support
  shell_lang bash
  shell |
    set -euo pipefail
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    node "$ROOT/tools/api-server.mjs" ${dir:-demos/pf-web-polyglot-demo-plus-c/web} ${port:-8080}
end

task web-dev-static
  describe Start basic static file server (legacy)
  shell_lang bash
  shell |
    set -euo pipefail
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    node "$ROOT/tools/static-server.mjs" ${dir:-web} ${port:-8080}
end

task api-server
  describe Start REST API server
  shell_lang bash
  shell |
    set -euo pipefail
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    node "$ROOT/tools/api-server.mjs" ${dir:-demos/pf-web-polyglot-demo-plus-c/web} ${port:-8080}
end

task web-test
  
  shell npx playwright test --reporter=list
end

task web-build-rust
  
  shell cd demos/pf-web-polyglot-demo-plus-c/rust && wasm-pack build --target web --out-dir ../web/wasm/rust/pkg --out-name rust_demo
end

task web-build-rust-wasm
  describe Build Rust to WebAssembly
  
  shell cd demos/pf-web-polyglot-demo-plus-c/rust && wasm-pack build --target web --out-dir ../web/wasm/rust/pkg --out-name rust_demo
end

task web-build-rust-llvm
  describe Build Rust to LLVM IR with optimization (opt_level=3 by default, parallel=false)
  
  shell cd demos/pf-web-polyglot-demo-plus-c/rust && mkdir -p ../web/llvm/rust && rustc --emit=llvm-ir --crate-type=lib -C opt-level=${opt_level:-3} src/lib_simple.rs -o ../web/llvm/rust/lib.ll
end

task web-build-c
  
  shell cd demos/pf-web-polyglot-demo-plus-c/c && emcc c_trap.c -O0 -sASSERTIONS=1 -sMODULARIZE -sEXPORT_ES6 -sENVIRONMENT=web -sEXPORTED_FUNCTIONS=_trigger_trap,_main -sINVOKE_RUN=0 -o ../web/wasm/c/c_trap.js
end

task web-build-c-wasm
  describe Build C to WebAssembly
  
  shell cd demos/pf-web-polyglot-demo-plus-c/c && emcc c_trap.c -O0 -sASSERTIONS=1 -sMODULARIZE -sEXPORT_ES6 -sENVIRONMENT=web -sEXPORTED_FUNCTIONS=_trigger_trap,_main -sINVOKE_RUN=0 -o ../web/wasm/c/c_trap.js
end

task web-build-c-asm
  describe Build C to asm.js
  
  shell cd demos/pf-web-polyglot-demo-plus-c/c && emcc c_trap.c -O2 -sWASM=0 -sMODULARIZE -sEXPORT_ES6 -sENVIRONMENT=web -sEXPORTED_FUNCTIONS=_trigger_trap,_main -sINVOKE_RUN=0 -o ../web/asm/c/c_trap_asm.js
end

task web-build-c-llvm
  describe Build C to LLVM IR with optimization (opt_level=3 by default, parallel=false for OpenMP)
  
  shell cd demos/pf-web-polyglot-demo-plus-c/c && mkdir -p .tmp ../web/llvm/c && echo "#define EMSCRIPTEN_KEEPALIVE" > .tmp/emscripten.h && clang -S -emit-llvm -O${opt_level:-3} ${parallel:+-fopenmp} -I.tmp c_trap.c -o ../web/llvm/c/c_trap.ll && rm -rf .tmp
end

task web-build-fortran
  
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && mkdir -p ../web/wasm/fortran
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && emcc hello_stub.c -O1 -sASSERTIONS=1 -sSTANDALONE_WASM=1 -o ../web/wasm/fortran/fortran.wasm
end

task web-build-fortran-wasm
  describe Build Fortran to WebAssembly
  
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && mkdir -p ../web/wasm/fortran
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && emcc hello_stub.c -O1 -sASSERTIONS=1 -sSTANDALONE_WASM=1 -o ../web/wasm/fortran/fortran.wasm
end

task web-build-fortran-llvm
  describe Build Fortran to LLVM IR with optimization (opt_level=3 by default, parallel=false for OpenMP)
  
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && mkdir -p ../web/llvm/fortran
  shell cd demos/pf-web-polyglot-demo-plus-c/fortran && clang -S -emit-llvm -O${opt_level:-3} ${parallel:+-fopenmp} hello_stub.c -o ../web/llvm/fortran/hello.ll
end

task web-build-wat
  
  shell cd demos/pf-web-polyglot-demo-plus-c/asm && wat2wasm mini.wat -o ../web/wasm/asm/mini.wasm
end

task web-build-wat-wasm
  describe Build WAT to WebAssembly
  
  shell cd demos/pf-web-polyglot-demo-plus-c/asm && wat2wasm mini.wat -o ../web/wasm/asm/mini.wasm
end

task web-build-all
  shell pf web-toolchain-check
  shell pf web-build-rust
  shell pf web-build-c
  shell pf web-build-fortran
  shell pf web-build-wat
end

task web-build-all-wasm
  describe Build all languages to WebAssembly
  shell pf web-toolchain-check
  shell pf web-build-rust-wasm
  shell pf web-build-c-wasm
  shell pf web-build-fortran-wasm
  shell pf web-build-wat-wasm
end

task web-build-all-asm
  describe Build all languages to asm.js where supported
  shell pf web-toolchain-check
  shell pf web-build-c-asm
end

task web-build-all-llvm
  describe Build all languages to LLVM IR where supported (with O3 by default, use opt_level= and parallel=true as needed)
  shell pf web-toolchain-check
  shell pf web-build-rust-llvm opt_level=${opt_level:-3}
  shell pf web-build-c-llvm opt_level=${opt_level:-3} parallel=${parallel:-false}
  shell pf web-build-fortran-llvm opt_level=${opt_level:-3} parallel=${parallel:-false}
end

task web-toolchain-check
  describe Verify required web/WASM toolchains are installed
  shell_lang bash
  shell |
    python3 - <<'PY'
import shutil
reqs = ["wasm-pack", "emcc", "wat2wasm", "clang", "lfortran"]
missing = [c for c in reqs if shutil.which(c) is None]
if missing: print('[ERR] Missing toolchain components:', ' '.join(missing)); print('Install hints:'); print('  - emcc/emsdk: https://emscripten.org/docs/getting_started/downloads.html'); print('  - wasm-pack: https://rustwasm.github.io/wasm-pack/installer/')
else: print('[OK] Web toolchain ready:', ', '.join(reqs))
PY
 end

    if [ -n "$DEB" ] && [ -f "$DEB" ] && command -v dpkg >/dev/null 2>&1; then
      echo "[install] Installing pf from deb: $DEB (deb controls prefix)"
      sudo dpkg -i "$DEB" || { echo "[install] Fixing deps..."; sudo apt-get -f install -y && sudo dpkg -i "$DEB"; }
      exit 0
    fi

    if [ ! -x "$INSTALLER" ]; then
      echo "[ERR] canonical installer not found at $INSTALLER" >&2
      echo "      Build it with: pf build-packages (or consult build-packages/pf-runner-1.0.0)" >&2
      exit 127
    fi

    echo "Installing to prefix=$prefix using $INSTALLER"
    if [ "$(id -u)" -ne 0 ] && [ "$prefix" = "/usr/local" ]; then
      sudo "$INSTALLER" --prefix "$prefix"
    else
      "$INSTALLER" --prefix "$prefix"
    fi
end

task install-help
  describe Show install task choices (simplified)
  shell printf '%s\n' "Install options:" "  pf install                 # Native install (default /usr/local)" "  pf install prefix=~/.local # Install to custom prefix (no sudo needed)" "  pf install-all             # pf install + tooling bundles" "  pf install-prereq-check    # Validate installer prerequisites on this host" "  pf install-verify          # Check post-install tool availability" "  pf install-smoke-test      # Minimal CI smoke of installer"
end

task install-prereq-check
  describe Validate required prerequisites before running installer tasks
  shell_lang bash
  shell |
    set -euo pipefail

    has() { command -v "$1" >/dev/null 2>&1; }
    ok() { printf '[OK] %s\n' "$1"; }
    warn() { printf '[WARN] %s\n' "$1"; }

    missing_critical=0
    os="$(uname -s)"

    echo "Installer prerequisite check"
    echo "==========================="
    echo "OS: ${os}"
    echo ""

    if [ "$os" = "Linux" ]; then
      if has apt-get || has dnf || has pacman || has zypper; then
        ok "Detected supported Linux package manager"
      else
        warn "No supported package manager found (expected one of: apt-get, dnf, pacman, zypper)"
      fi
    elif [ "$os" = "Darwin" ]; then
      if has brew; then
        ok "Homebrew is available"
      else
        warn "Homebrew not found; install from https://brew.sh/"
      fi
    else
      warn "Unsupported OS for automated installer tasks: ${os}"
    fi

    if has bash; then
      ok "bash is installed"
    else
      warn "bash is missing"
      missing_critical=1
    fi

    if has python3; then
      ok "python3 is installed ($(python3 --version 2>/dev/null | awk '{print $2}'))"
    else
      warn "python3 is missing (required for pf task execution)"
      missing_critical=1
    fi

    if has git; then
      ok "git is installed"
    else
      warn "git is missing (needed by some installers and workflows)"
      missing_critical=1
    fi

    if has curl || has wget; then
      ok "download utility available (curl/wget)"
    else
      warn "Neither curl nor wget is available"
      missing_critical=1
    fi

    if has sudo; then
      ok "sudo available for system-level installs"
    else
      warn "sudo not available (use user-prefix installs like prefix=~/.local)"
    fi

    echo ""
    if [ "$missing_critical" -eq 0 ]; then
      ok "Prerequisite check passed. You can run installer tasks."
    else
      echo "[ERR] One or more critical prerequisites are missing."
      echo "      Install missing tools, then rerun: pf install-prereq-check"
      exit 1
    fi
end

task install-verify
  describe Verify pf/runtime dependencies and common installer-provided tools
  shell_lang bash
  shell |
    set -euo pipefail

    check_cmd() {
      local cmd="$1"
      local label="$2"
      if command -v "$cmd" >/dev/null 2>&1; then
        echo "[OK] ${label}: $(command -v "$cmd")"
      else
        echo "[MISSING] ${label} (${cmd})"
      fi
    }

    echo "Post-install verification"
    echo "========================"
    echo ""
    echo "Core runtime:"
    check_cmd python3 "Python runtime"
    check_cmd pf "pf command"
    echo ""

    echo "Python libraries:"
    if python3 - <<'PY'
import importlib
mods = ("fabric", "lark", "typer")
missing = [m for m in mods if importlib.util.find_spec(m) is None]
if missing:
    print("[MISSING] Python modules:", ", ".join(missing))
    raise SystemExit(1)
print("[OK] Python modules: fabric, lark, typer")
PY
    then
      :
    else
      echo "  Install with: python3 -m pip install --user \"fabric>=3.2,<4\" \"lark>=1.1.0\" \"typer>=0.12\""
    fi
    echo ""

    echo "Common installer tools:"
    check_cmd checksec "checksec"
    check_cmd patchelf "patchelf"
    check_cmd nasm "nasm"
    check_cmd wasm-opt "binaryen (wasm-opt)"
    check_cmd wat2wasm "wabt (wat2wasm)"
    check_cmd ROPgadget "ROPgadget"
    check_cmd ropper "ropper"
    check_cmd gdb "GDB"
    check_cmd lldb "LLDB"
    echo ""

    echo "If tools are missing, run:"
    echo "  pf install-help"
    echo "  pf category-installation-help"
end

task install-all
  describe Install pf plus core tool categories
  shell pf install
  shell pf install-exploit-tools
  shell pf install-security-tools
  shell pf install-all-debug-tools
  shell pf install-pkg-tools
  shell pf install-tui-deps
  shell pf install-fuzzing-tools
  shell pf install-lifting-tools
  shell pf install-sanitizer-tools
end

task install-smoke-test
  describe Run a minimal end-to-end install and command smoke test (CI helper)
  shell_lang bash
  shell |
    set -euo pipefail

    PREFIX="$(mktemp -d /tmp/pf-smoke-XXXX)"
    trap 'rm -rf "$PREFIX"' EXIT

    echo "Using PREFIX=$PREFIX"
    find_root() {
      if [ -n "${PFY_ROOT:-}" ] && [ -d "${PFY_ROOT}" ]; then
        if [ -f "${PFY_ROOT}/Pfyfile.pf" ]; then
          echo "$(cd "${PFY_ROOT}/.." && pwd)"
        else
          echo "${PFY_ROOT}"
        fi
        return
      fi
      if [ -n "${PFY_FILE_PATH:-}" ] && [ -f "${PFY_FILE_PATH}" ]; then
        echo "$(cd "$(dirname "${PFY_FILE_PATH}")/.." && pwd)"
        return
      fi
      if git rev-parse --show-toplevel >/dev/null 2>&1; then
        git rev-parse --show-toplevel
        return
      fi
      cur="$PWD"
      while [ "$cur" != "/" ]; do
        if [ -d "$cur/pf-files" ] && [ -f "$cur/pf-files/Pfyfile.pf" ]; then
          echo "$cur"
          return
        fi
        cur="$(dirname "$cur")"
      done
      python3 - <<'PY'
import importlib.util, pathlib
spec = importlib.util.find_spec("pf_main")
root = pathlib.Path(spec.origin).resolve().parent.parent if spec and spec.origin else pathlib.Path().resolve()
print(root)
PY
    }

    ROOT="${PF_ROOT:-$(find_root)}"
    DEB="$(ls -1 "$ROOT"/build-packages/deb/pf-runner_*.deb 2>/dev/null | sort -V | tail -n1 || true)"
    INSTALLER="$ROOT/build-packages/pf-runner-1.0.0/install.sh"
    if [ -n "$DEB" ] && [ -f "$DEB" ] && command -v dpkg >/dev/null 2>&1; then
      echo "[install-smoke-test] Installing pf from deb: $DEB"
      sudo dpkg -i "$DEB" || { echo "[install-smoke-test] Fixing deps..."; sudo apt-get -f install -y && sudo dpkg -i "$DEB"; }
    else
      if [ ! -x "$INSTALLER" ]; then
        echo "[ERR] canonical installer not found at $INSTALLER" >&2
        echo "      Build it with: pf build-packages (or consult build-packages/pf-runner-1.0.0)" >&2
        exit 127
      fi
      "$INSTALLER" --prefix "$PREFIX" --skip-deps
    fi

    PATH="$PREFIX/bin:$PATH" pf --version
    PATH="$PREFIX/bin:$PATH" pf list >/dev/null

    echo "install-smoke-test passed at $PREFIX"
end

task debug-check-podman
  describe Show podman visibility from inside pf container
  shell command -v podman || echo "podman not in PATH"
  shell ls -l /usr/bin/podman || true
  shell env | grep -E 'XDG_RUNTIME_DIR|CONTAINER_HOST' || true
end

task sync-demo
  describe Demo of sync command - sync files with rsync
  
  shell echo "Sync command examples:"
  shell echo "  Local:  sync src=/path/src/ dest=/path/dest/ verbose"
  shell echo "  Remote: sync src=/local/ dest=/remote/ host=server.com user=deploy port=22"
  shell echo "  Excludes: sync src=./ dest=/backup/ excludes=[\"*.log\",\"*.tmp\"] delete dry"
  shell echo "  From file: sync src=./ dest=/backup/ exclude_file=.rsync-exclude"
  shell echo "See pf-runner/SYNC.md for full documentation"
end

task thing
     describe "Do python instead"
     shell_lang
     print("I'm a python script!")
end
