# Include enhanced workflow tasks
include enhanced-tasks/Pfyfile.enhanced-workflows.pf

# Include binary lifting tasks
include llvm-lifting/Pfyfile.lifting.pf

# Include binary injection tasks
include vuln-hunting/Pfyfile.injection.pf
