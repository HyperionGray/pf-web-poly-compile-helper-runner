include exploit-writing/Pfyfile.rop.pf
# Include practice binaries tasks
include practice/Pfyfile.practice.pf

# Include fuzzing tasks
include vuln-hunting/Pfyfile.fuzzing.pf

# Include sanitizer deep-dive tasks (analysis, wrappers, demos)
