# PE Execution Container - Windows Server Nano via QEMU/KVM
# Mirrors the Windows Server Core container but targets Nano Server images
FROM ubuntu:22.04

LABEL maintainer="pf-runner"
LABEL description="PE execution environment using Windows Server Nano"
LABEL os.type="windows-server-nano"
LABEL os.version="2022"
LABEL execution.type="pe"
LABEL vm.backend="qemu-kvm"

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential tools and dependencies for QEMU-based Windows execution
RUN apt-get update && \
    apt-get install -y \
        qemu-system-x86 \
        qemu-utils \
        qemu-kvm \
        libvirt-daemon-system \
        libvirt-clients \
        bridge-utils \
        ovmf \
        wget \
        curl \
        git \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        pkg-config \
        libssl-dev \
        socat \
        netcat-openbsd \
        jq \
        unzip \
        p7zip-full \
        cabextract \
        wimtools \
        genisoimage \
        samba-common-bin \
        cifs-utils \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create directories for VM management
RUN mkdir -p /opt/pe-execution \
    /opt/windows-images \
    /opt/vm-instances \
    /artifacts/pe-results \
    /artifacts/vm-logs

# Create Windows Server Nano VM template preparation script
RUN cat > /opt/pe-execution/prepare-windows-nano.sh << 'EOF'
#!/bin/bash
# Prepare Windows Server Nano VM template

set -e

NANO_VHD_PATH="${NANO_VHD_PATH:-/opt/windows-images/nanoserver.vhdx}"
NANO_QCOW_PATH="${NANO_QCOW_PATH:-/opt/windows-images/windows-nano.qcow2}"
NANO_URL="${NANOSERVER_VHD_URL:-${WINDOWS_NANO_URL:-}}"
VM_SIZE="${VM_SIZE:-10G}"
VM_MEMORY="${VM_MEMORY:-1536}"

echo "[*] Preparing Windows Server Nano VM template..."

# If qcow2 already exists, keep it
if [ -f "$NANO_QCOW_PATH" ]; then
    echo "[*] Existing Nano Server qcow2 detected: $NANO_QCOW_PATH"
    echo "[*] Delete the file if you want to recreate it."
    exit 0
fi

# Download VHDX if a URL is provided and local file missing
if [ ! -f "$NANO_VHD_PATH" ] && [ -n "$NANO_URL" ]; then
    echo "[*] Downloading Nano Server VHDX..."
    mkdir -p "$(dirname "$NANO_VHD_PATH")"
    if ! wget -O "$NANO_VHD_PATH" "$NANO_URL"; then
        echo "[!] Download failed. Please verify NANOSERVER_VHD_URL."
        exit 1
    fi
fi

if [ ! -f "$NANO_VHD_PATH" ]; then
    cat <<INSTRUCTIONS
[!] Nano Server VHDX not found.
    - Place a Nano Server VHDX at: $NANO_VHD_PATH
    - Or set NANOSERVER_VHD_URL to an evaluation VHDX download link.
    - The file should be accessible to the container at build/runtime.
INSTRUCTIONS
    exit 1
fi

echo "[*] Converting Nano Server VHDX to qcow2..."
qemu-img convert -f vhdx -O qcow2 "$NANO_VHD_PATH" "$NANO_QCOW_PATH"
echo "[*] Nano Server template ready: $NANO_QCOW_PATH"
EOF

RUN chmod +x /opt/pe-execution/prepare-windows-nano.sh

# Create PE execution wrapper script for Nano Server
RUN cat > /opt/pe-execution/execute-pe-nano.sh << 'EOF'
#!/bin/bash
# Execute PE file inside a Windows Server Nano VM

set -e

PE_FILE="$1"
OUTPUT_DIR="${2:-/artifacts/pe-results}"
VM_INSTANCE_ID="${3:-nano-exec-$(date +%s)}"
TIMEOUT="${TIMEOUT:-300}"
NANO_TEMPLATE="${NANO_TEMPLATE:-/opt/windows-images/windows-nano.qcow2}"
VM_MEMORY="${VM_MEMORY:-1536}"
VM_CPUS="${VM_CPUS:-2}"

if [ -z "$PE_FILE" ] || [ ! -f "$PE_FILE" ]; then
    echo "Usage: execute-pe-nano.sh <pe-file> [output-dir] [vm-instance-id]"
    echo "Error: PE file not found: $PE_FILE"
    exit 1
fi

if [ ! -f "$NANO_TEMPLATE" ]; then
    echo "[!] Windows Server Nano image not found: $NANO_TEMPLATE"
    echo "[!] Run: pf-prepare-windows-nano with NANOSERVER_VHD_URL or mount a Nano VHDX at /opt/windows-images"
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

VM_DIR="/opt/vm-instances/$VM_INSTANCE_ID"
mkdir -p "$VM_DIR"

VM_DISK="$VM_DIR/disk.qcow2"
cp "$NANO_TEMPLATE" "$VM_DISK"

PE_SHARED_DIR="$VM_DIR/shared"
mkdir -p "$PE_SHARED_DIR"
cp "$PE_FILE" "$PE_SHARED_DIR/"
PE_FILENAME=$(basename "$PE_FILE")

cat > "$VM_DIR/execute.sh" << 'VM_EOF'
#!/bin/bash
VM_DISK="$1"
PE_SHARED_DIR="$2"
PE_FILENAME="$3"
VM_INSTANCE_ID="$4"
TIMEOUT="$5"
VM_MEMORY="$6"
VM_CPUS="$7"

echo "[*] Starting Windows Server Nano VM..."

timeout "$TIMEOUT" qemu-system-x86_64 \
    -enable-kvm \
    -m "$VM_MEMORY" \
    -smp "$VM_CPUS" \
    -drive file="$VM_DISK",format=qcow2 \
    -netdev user,id=net0,smb="$PE_SHARED_DIR" \
    -device e1000,netdev=net0 \
    -vnc :1 \
    -daemonize \
    -pidfile "$VM_INSTANCE_ID.pid" \
    -monitor unix:"$VM_INSTANCE_ID.monitor",server,nowait \
    -serial file:"$VM_INSTANCE_ID.serial" \
    -boot c

sleep 25

echo "[*] VM started. Manual steps are required inside Nano Server:"
echo "    - Connect via VNC display :1"
echo "    - The PE is shared via SMB: \\\\10.0.2.4\\qemu\\$PE_FILENAME"
echo "    - Run it with PowerShell or cmd inside the VM."

echo "[*] Gathering status..."
echo "info status" | socat - UNIX-CONNECT:"$VM_INSTANCE_ID.monitor" || true

echo "[*] Shutting down VM..."
echo "quit" | socat - UNIX-CONNECT:"$VM_INSTANCE_ID.monitor" || true
VM_EOF

chmod +x "$VM_DIR/execute.sh"

echo "[*] Launching Nano Server for PE execution..."
"$VM_DIR/execute.sh" "$VM_DISK" "$PE_SHARED_DIR" "$PE_FILENAME" "$VM_DIR/vm" "$TIMEOUT" "$VM_MEMORY" "$VM_CPUS"

cp "$VM_DIR/vm.serial" "$OUTPUT_DIR/execution-nano.log" 2>/dev/null || true

cat > "$OUTPUT_DIR/execution-nano-report.json" << REPORT_EOF
{
    "pe_file": "$PE_FILE",
    "vm_instance_id": "$VM_INSTANCE_ID",
    "execution_time": "$(date -Iseconds)",
    "status": "completed",
    "output_dir": "$OUTPUT_DIR",
    "vm_logs": "$VM_DIR/vm.serial"
}
REPORT_EOF

echo "[*] PE execution completed (manual interaction may still be required)"
echo "[*] Results available in: $OUTPUT_DIR"

rm -rf "$VM_DIR"
EOF

RUN chmod +x /opt/pe-execution/execute-pe-nano.sh

# Create status helper script
RUN cat > /usr/local/bin/pf-pe-nano-status << 'EOF'
#!/bin/bash
echo "=== Windows Server Nano PE Environment ==="
echo ""
echo "QEMU Status:"
if command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "  ✓ qemu-system-x86_64 available"
else
    echo "  ✗ qemu-system-x86_64 missing"
fi

echo ""
echo "KVM Status:"
if [ -r /dev/kvm ]; then
    echo "  ✓ /dev/kvm available"
else
    echo "  ⚠ KVM not available (falls back to software emulation)"
fi

echo ""
echo "Nano Image:"
if [ -f "/opt/windows-images/windows-nano.qcow2" ]; then
    echo "  ✓ /opt/windows-images/windows-nano.qcow2 present"
else
    echo "  ✗ Nano qcow2 missing (run pf-prepare-windows-nano)"
fi
EOF

RUN chmod +x /usr/local/bin/pf-pe-nano-status

# Create wrapper scripts
RUN cat > /usr/local/bin/pf-execute-pe-nano << 'EOF'
#!/bin/bash
PE_FILE="$1"
if [ -z "$PE_FILE" ]; then
    echo "Usage: pf-execute-pe-nano <pe-file>"
    exit 1
fi
/opt/pe-execution/execute-pe-nano.sh "$PE_FILE"
EOF

RUN chmod +x /usr/local/bin/pf-execute-pe-nano

RUN cat > /usr/local/bin/pf-prepare-windows-nano << 'EOF'
#!/bin/bash
echo "Preparing Windows Server Nano VM template..."
echo "You must provide a Nano Server VHDX (set NANOSERVER_VHD_URL or mount into /opt/windows-images)."
/opt/pe-execution/prepare-windows-nano.sh
EOF

RUN chmod +x /usr/local/bin/pf-prepare-windows-nano

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]

# Environment variables
ENV OS_TYPE=windows-server-nano
ENV OS_VERSION=2022
ENV EXECUTION_TYPE=pe
ENV VM_BACKEND=qemu-kvm
ENV ARTIFACTS_DIR=/artifacts
ENV PE_TIMEOUT=300
ENV VM_MEMORY=1536
ENV VM_CPUS=2
