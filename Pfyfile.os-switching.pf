# OS Switching and Replacement Tasks
# EXTREMELY DANGEROUS - Full OS replacement functionality
# WARNING: These operations can render your system unbootable!

# ==========================================
# SAFETY WARNING TASKS
# ==========================================

task os-switching-warning
  describe Show safety warning for OS switching operations
  shell_lang bash
  shell cat << 'EOF'

⚠️  EXTREME DANGER WARNING ⚠️
=============================

The OS switching functionality in this file is EXTREMELY DANGEROUS and can:
- Render your system completely unbootable
- Cause permanent data loss
- Require physical access to recover
- Destroy your current operating system

ONLY USE THESE COMMANDS IF:
✅ You have a complete system backup
✅ You have tested on disposable VMs first
✅ You have physical access to the machine
✅ You have alternative recovery methods
✅ You understand the risks completely

RECOMMENDED: Use the safer container-based OS environments instead:
  pf os-help

Continue only if you accept full responsibility for system destruction.

EOF
end

# ==========================================
# Backup and Safety Tasks
# ==========================================

task os-backup-system
  describe Create full system backup before OS switching
  shell_lang bash
  shell |
    echo "⚠️  Creating full system backup..."
    
    # Check available backup methods
    BACKUP_METHOD=""
    if command -v btrfs &>/dev/null && btrfs filesystem show / &>/dev/null; then
        BACKUP_METHOD="btrfs"
    elif command -v zfs &>/dev/null && zfs list / &>/dev/null; then
        BACKUP_METHOD="zfs"
    else
        BACKUP_METHOD="rsync"
    fi
    
    echo "Using backup method: $BACKUP_METHOD"
    
    case "$BACKUP_METHOD" in
        btrfs)
            echo "Creating btrfs snapshot..."
            sudo btrfs subvolume snapshot / /backup-$(date +%Y%m%d-%H%M%S)
            ;;
        zfs)
            echo "Creating ZFS snapshot..."
            sudo zfs snapshot rpool/ROOT/ubuntu@backup-$(date +%Y%m%d-%H%M%S)
            ;;
        rsync)
            echo "Creating rsync backup (this will take a while)..."
            sudo mkdir -p /backup/system-$(date +%Y%m%d-%H%M%S)
            sudo rsync -aAXv --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} / /backup/system-$(date +%Y%m%d-%H%M%S)/
            ;;
    esac
    
    echo "✅ System backup completed"
end

task os-create-mirror-container
  describe Create MirrorOS container for continuous snapshots
  shell_lang bash
  shell |
    echo "Creating MirrorOS container for continuous system snapshots..."
    
    # Create MirrorOS Dockerfile
    cat > /tmp/Dockerfile.mirror-os << 'EOF'
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    rsync \
    btrfs-progs \
    zfsutils-linux \
    cron \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Create snapshot script
RUN cat > /usr/local/bin/mirror-snapshot << 'SCRIPT'
#!/bin/bash
set -e

SNAPSHOT_DIR="/snapshots"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)

echo "Creating snapshot at $TIMESTAMP"

# Determine backup method
if [ -f /.btrfs ]; then
    btrfs subvolume snapshot /host "$SNAPSHOT_DIR/btrfs-$TIMESTAMP"
elif [ -f /.zfs ]; then
    zfs snapshot rpool/ROOT/ubuntu@mirror-$TIMESTAMP
else
    rsync -aAX --delete /host/ "$SNAPSHOT_DIR/rsync-$TIMESTAMP/"
fi

# Keep only last 10 snapshots
ls -t "$SNAPSHOT_DIR" | tail -n +11 | xargs -r rm -rf

echo "Snapshot $TIMESTAMP completed"
SCRIPT

RUN chmod +x /usr/local/bin/mirror-snapshot

# Set up cron for regular snapshots
RUN echo "*/30 * * * * /usr/local/bin/mirror-snapshot" | crontab -

CMD ["cron", "-f"]
EOF
    
    # Build MirrorOS container
    podman build -t localhost/pf-mirror-os:latest -f /tmp/Dockerfile.mirror-os .
    
    echo "✅ MirrorOS container created"
    echo "Start with: podman run -d --name mirror-os --volume /:/host:ro --volume /opt/pf-snapshots:/snapshots localhost/pf-mirror-os:latest"
end

task os-start-mirror
  describe Start MirrorOS continuous snapshot service
  shell_lang bash
  shell |
    echo "Starting MirrorOS continuous snapshot service..."
    
    # Create snapshot directory
    sudo mkdir -p /opt/pf-snapshots
    
    # Start MirrorOS container
    podman run -d --name pf-mirror-os \
        --volume /:/host:ro \
        --volume /opt/pf-snapshots:/snapshots \
        --restart=always \
        localhost/pf-mirror-os:latest
    
    echo "✅ MirrorOS started - taking snapshots every 30 minutes"
    echo "View logs: podman logs -f pf-mirror-os"
end

# ==========================================
# Pre-Switch Validation Tasks
# ==========================================

task os-validate-switch-requirements target_os=""
  describe Validate system requirements for OS switching
  shell_lang bash
  shell |
    if [ -z "${target_os}" ]; then
        echo "Usage: pf os-validate-switch-requirements target_os=<centos|fedora|arch|opensuse>"
        exit 1
    fi
    
    echo "🔍 Validating requirements for switching to ${target_os}..."
    
    # Check if we're in a VM (safer)
    if systemd-detect-virt &>/dev/null; then
        echo "✅ Running in virtualized environment (safer)"
    else
        echo "⚠️  Running on bare metal (DANGEROUS)"
        read -p "Continue anyway? (type 'YES' to proceed): " confirm
        if [ "$confirm" != "YES" ]; then
            echo "Aborted"
            exit 1
        fi
    fi
    
    # Check available disk space
    AVAILABLE_GB=$(df / | awk 'NR==2 {print int($4/1024/1024)}')
    if [ "$AVAILABLE_GB" -lt 20 ]; then
        echo "❌ Insufficient disk space: ${AVAILABLE_GB}GB (need at least 20GB)"
        exit 1
    else
        echo "✅ Sufficient disk space: ${AVAILABLE_GB}GB"
    fi
    
    # Check if target OS container exists
    if ! podman image exists localhost/pf-os-${target_os}:latest; then
        echo "❌ Target OS container not found: pf-os-${target_os}"
        echo "Build it first: pf os-build-${target_os}"
        exit 1
    else
        echo "✅ Target OS container available"
    fi
    
    # Check backup status
    if [ ! -d "/opt/pf-snapshots" ] || [ -z "$(ls -A /opt/pf-snapshots 2>/dev/null)" ]; then
        echo "❌ No system backups found"
        echo "Create backup first: pf os-backup-system"
        exit 1
    else
        echo "✅ System backups available"
    fi
    
    # Check kexec availability
    if ! command -v kexec &>/dev/null; then
        echo "❌ kexec not available"
        echo "Install with: sudo apt-get install kexec-tools"
        exit 1
    else
        echo "✅ kexec available"
    fi
    
    echo "✅ All requirements validated for ${target_os} switch"
end

# ==========================================
# DANGEROUS OS Switching Tasks
# ==========================================

task os-kexec-prepare kernel="" initrd="" cmdline="" dry_run="true"
  describe Prepare a kexec switch to a new kernel/initrd (does NOT execute)
  shell_lang bash
  shell |
    set -euo pipefail

    if [ -z "${kernel}" ] || [ -z "${initrd}" ]; then
        echo "Usage: pf os-kexec-prepare kernel=/path/to/vmlinuz initrd=/path/to/initrd [cmdline='...'] [dry_run=true|false]"
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ Root required. Re-run with sudo."
        exit 1
    fi

    if ! command -v kexec &>/dev/null; then
        echo "❌ kexec not available. Install with: pf install-kexec"
        exit 1
    fi

    if [ ! -r "${kernel}" ]; then
        echo "❌ Kernel not readable: ${kernel}"
        exit 1
    fi
    if [ ! -r "${initrd}" ]; then
        echo "❌ Initrd not readable: ${initrd}"
        exit 1
    fi

    if [ -z "${cmdline}" ]; then
        cmdline="$(cat /proc/cmdline)"
        echo "ℹ️  No cmdline provided. Using current /proc/cmdline."
    fi

    if [ "${dry_run}" = "true" ]; then
        echo "✅ Dry run only. Would execute:"
        echo "kexec -l '${kernel}' --initrd='${initrd}' --command-line='${cmdline}'"
        echo ""
        echo "Then execute the switch with:"
        echo "  sudo kexec -e"
        exit 0
    fi

    echo "Loading kernel via kexec..."
    kexec -l "${kernel}" --initrd="${initrd}" --command-line="${cmdline}"
    echo "✅ Kernel loaded."
    echo ""
    echo "⚠️  To execute the switch, run:"
    echo "  sudo kexec -e"
end

task os-kexec-exec confirm=""
  describe Execute the kexec switch (requires explicit confirm phrase)
  shell_lang bash
  shell |
    set -euo pipefail

    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ Root required. Re-run with sudo."
        exit 1
    fi

    if [ "${confirm}" != "EXECUTE KEXEC NOW" ]; then
        echo "Refusing to proceed without explicit confirmation."
        echo "Re-run with: pf os-kexec-exec confirm='EXECUTE KEXEC NOW'"
        exit 1
    fi

    echo "⚠️  Executing kexec -e (this will immediately switch kernels)!"
    kexec -e
end

task os-kexec-arch-iso iso="" cmdline="" mount_dir="/mnt/pf-arch-iso" dry_run="true"
  describe Prepare kexec to Arch ISO kernel/initrd (does NOT execute)
  shell_lang bash
  shell |
    set -euo pipefail

    if [ -z "${iso}" ]; then
        echo "Usage: pf os-kexec-arch-iso iso=/path/to/archlinux.iso [cmdline='...'] [mount_dir=/mnt/pf-arch-iso] [dry_run=true|false]"
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        echo "❌ Root required. Re-run with sudo."
        exit 1
    fi

    if ! command -v kexec &>/dev/null; then
        echo "❌ kexec not available. Install with: pf install-kexec"
        exit 1
    fi

    if [ ! -r "${iso}" ]; then
        echo "❌ ISO not readable: ${iso}"
        exit 1
    fi

    mkdir -p "${mount_dir}"
    if ! mountpoint -q "${mount_dir}"; then
        mount -o loop,ro "${iso}" "${mount_dir}"
    fi

    kernel="${mount_dir}/arch/boot/x86_64/vmlinuz-linux"
    initrd="${mount_dir}/arch/boot/x86_64/initramfs-linux.img"

    if [ ! -r "${kernel}" ] || [ ! -r "${initrd}" ]; then
        echo "❌ Arch ISO kernel/initrd not found in expected location."
        echo "Expected:"
        echo "  ${kernel}"
        echo "  ${initrd}"
        umount "${mount_dir}" || true
        exit 1
    fi

    if [ -z "${cmdline}" ]; then
        label="$(blkid -o value -s LABEL "${iso}" 2>/dev/null || true)"
        if [ -n "${label}" ]; then
            echo "ℹ️  ISO label detected: ${label}"
            echo "Suggested cmdline (adjust as needed):"
            echo "  archisobasedir=arch archisolabel=${label}"
        else
            echo "ℹ️  No ISO label detected."
            echo "Provide a cmdline explicitly for Arch ISO boot."
        fi
        umount "${mount_dir}" || true
        exit 1
    fi

    if [ "${dry_run}" = "true" ]; then
        echo "✅ Dry run only. Would execute:"
        echo "kexec -l '${kernel}' --initrd='${initrd}' --command-line='${cmdline}'"
        echo ""
        echo "Then execute the switch with:"
        echo "  sudo kexec -e"
        umount "${mount_dir}" || true
        exit 0
    fi

    echo "Loading Arch ISO kernel via kexec..."
    kexec -l "${kernel}" --initrd="${initrd}" --command-line="${cmdline}"
    umount "${mount_dir}" || true
    echo "✅ Kernel loaded."
    echo ""
    echo "⚠️  To execute the switch, run:"
    echo "  sudo kexec -e"
end

