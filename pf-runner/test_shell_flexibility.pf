# Test file for shell_lang flexibility improvements

task test-basic-bash
  describe Test basic bash commands without shell prefix
  shell_lang bash
  echo "Step 1: Hello from bash"
  echo "Step 2: Current directory is $(pwd)"
  ls -la | head -5
end

task test-python-inline
  describe Test Python commands without shell prefix (each line is separate)
  shell_lang python
  print("Hello from Python!")
  print("Each line runs separately")
  import sys; print(f"Python version: {sys.version}")
end

task test-mixed-syntax
  describe Test mixing old and new syntax
  shell_lang bash
  echo "Using new syntax"
  shell echo "Using old syntax"
  echo "Back to new syntax"
end

task test-inline-lang-override
  describe Test [lang:xxx] overriding shell_lang
  shell_lang bash
  echo "This is bash"
  shell [lang:python] print("This is Python")
  echo "Back to bash"
end

task test-reset-lang
  describe Test resetting language to default
  shell_lang python
  print("Using Python")
  shell_lang default
  shell echo "Back to default shell"
end

task test-no-lang-error
  describe Test error when no lang is set (should fail gracefully)
  echo "This should produce a helpful error"
end

task test-with-variables
  describe Test variable interpolation with shell_lang
  shell_lang bash
  env TEST_VAR=hello
  echo "Variable value: $TEST_VAR"
  echo "Inline variable: ${TEST_VAR}_world"
end

task test-backward-compat
  describe Test backward compatibility with explicit shell prefix
  shell echo "Using old explicit shell syntax"
  shell echo "Still works as before"
end

