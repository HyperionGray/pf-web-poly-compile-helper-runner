#!/usr/bin/env python3
# pf-static - Self-contained pf executable
# Auto-generated by install-static.sh

import sys
import os
from pathlib import Path

# This wrapper looks for pf-runner-full in the repository
SCRIPT_DIR = Path(__file__).parent.resolve()
REPO_ROOT = SCRIPT_DIR.parent
PF_FULL_DIR = REPO_ROOT / "pf-runner-full"
PF_MAIN = PF_FULL_DIR / "pf_main.py"

# If we can't find pf-runner-full (e.g., after installation), 
# fall back to system installation
if not PF_MAIN.exists():
    # Try to find installed pf
    import shutil
    installed_pf = shutil.which('pf')
    if installed_pf and installed_pf != str(Path(__file__).resolve()):
        # Found another pf installation, use it
        import subprocess
        sys.exit(subprocess.call([installed_pf] + sys.argv[1:]))
    
    print(f"ERROR: pf-runner-full not found at {PF_FULL_DIR}", file=sys.stderr)
    print(f"ERROR: No fallback pf installation found", file=sys.stderr)
    print("", file=sys.stderr)
    print("To install pf properly, choose one of:", file=sys.stderr)
    print("  1. Package install: sudo dpkg -i build-packages/deb/pf-runner_*.deb", file=sys.stderr)
    print("  2. Makefile install: cd pf-runner-full && make local-install", file=sys.stderr)
    sys.exit(1)

# Add pf-runner-full to Python path
sys.path.insert(0, str(PF_FULL_DIR))

# Execute pf_main.py in-process
if __name__ == '__main__':
    with open(PF_MAIN) as f:
        code = compile(f.read(), str(PF_MAIN), 'exec')
        exec(code, {'__file__': str(PF_MAIN), '__name__': '__main__'})
