# Container and Quadlet management tasks
# Provides pf commands for building, running, and managing containers

# --
# Podman Compose Tasks
# --

task compose-up
  describe Start API server using podman-compose
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml up -d api-server pf-runner
end

task compose-down
  describe Stop all containers using podman-compose
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml down
end

task compose-build-wasm
  describe Build all WASM modules using containers
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml up build-rust build-c build-fortran build-wat
end

task compose-logs
  describe View container logs
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml logs -f ${service:-api-server}
end

task compose-status
  describe Show container status
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml ps -a
end

task compose-shell
  describe Open shell in container (default: debugger)
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml run --rm -it ${container:-debugger} /bin/bash
end

task compose-debugger
  describe Start debugging container interactively
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml run --rm -it debugger /bin/bash
end

task compose-debugger-gpu
  describe Start GPU-enabled debugger (requires nvidia-container-toolkit)
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml --profile gpu run --rm -it debugger-gpu /bin/bash
end

task compose-clean
  describe Remove all containers, volumes, and networks
  shell_lang bash
  shell cd "${PWD}" && podman-compose -f podman-compose.yml down -v --remove-orphans
end

# --
# Quadlet Management Tasks
# --

task quadlet-install
  describe Install Podman quadlet files for systemd integration
  shell_lang bash
  shell ./containers/scripts/install-quadlets.sh --install
end

task quadlet-remove
  describe Remove installed Podman quadlet files
  shell_lang bash
  shell ./containers/scripts/install-quadlets.sh --remove
end

task quadlet-status
  describe Show status of quadlet services
  shell_lang bash
  shell ./containers/scripts/install-quadlets.sh --status
end

task quadlet-list
  describe List installed quadlet files
  shell_lang bash
  shell ./containers/scripts/install-quadlets.sh --list
end

task quadlet-reload
  describe Reload systemd after quadlet changes
  shell_lang bash
  shell systemctl --user daemon-reload && echo "Systemd reloaded"
end

task quadlet-start-api
  describe Start API server via systemd quadlet
  shell_lang bash
  shell systemctl --user start pf-api-server && systemctl --user status pf-api-server
end

task quadlet-stop-api
  describe Stop API server via systemd quadlet
  shell_lang bash
  shell systemctl --user stop pf-api-server
end

task quadlet-logs
  describe View quadlet service logs
  shell_lang bash
  shell journalctl --user -u ${service:-pf-api-server} -f
end

task quadlet-enable
  describe Enable quadlet services at login (tries common units)
  shell_lang bash
  shell systemctl --user enable pf-api-server || true
  shell systemctl --user enable pf-web-api-pod || true
end

task quadlet-enable-all
  describe Enable and start the pf-suite.target (groups all pf units)
  shell_lang bash
  shell systemctl --user enable --now pf-suite.target || (echo "pf-suite.target missing — run: pf quadlet-install" && exit 1)
end

task quadlet-doctor
  describe Diagnose quadlet + podman + systemd-user environment
  shell_lang bash
  shell ./containers/scripts/quadlet-doctor.sh
end

task quadlet-restart-all
  describe Restart all pf services (from quadlets)
  shell_lang bash
  shell ./containers/scripts/quadlet-manage.sh restart-all
end

task quadlet-disable-all
  describe Disable pf-suite.target and all pf services
  shell_lang bash
  shell ./containers/scripts/quadlet-manage.sh disable-all
end

task quadlet-stop-all
  describe Stop all pf services
  shell_lang bash
  shell ./containers/scripts/quadlet-manage.sh stop-all
end

task quadlet-status-all
  describe Show status for all pf units (service/target)
  shell_lang bash
  shell ./containers/scripts/quadlet-manage.sh status-all
end

# --
# Development Workflow Tasks
# --

task dev-container
  describe Start development environment using containers
  shell_lang bash
  shell ./containers/scripts/run-dev.sh
end

task dev-container-build
  describe Build WASM modules using containers
  shell_lang bash
  shell ./containers/scripts/run-dev.sh build
end

task dev-container-debug
  describe Start debugging container
  shell_lang bash
  shell ./containers/scripts/run-dev.sh debug
end

# --
# Container Testing Tasks
# --

task container-test
  describe Run container infrastructure tests
  shell_lang bash
  shell ./containers/scripts/test-containers.sh
end

task dev-container-gpu
  describe Start GPU debugging container
  shell_lang bash
  shell ./containers/scripts/run-dev.sh gpu
end

task dev-container-status
  describe Show container development status
  shell_lang bash
  shell ./containers/scripts/run-dev.sh status
end

# --
# Automatic Containerization Tasks
# --

task auto-containerize
  describe Automatically containerize the current project
  containerize
end

task auto-containerize-dir dir=""
  describe Containerize a project in a specific directory
  containerize dir=$dir
end

task auto-containerize-hints dir="" install_deps="" main_bin="" port=""
  describe Containerize with hints for dependencies, main binary, and port
  containerize dir=$dir install_deps=$install_deps main_bin=$main_bin port=$port
end

task generate-dockerfile
  describe Generate a Dockerfile for the current project (no build)
  containerize dockerfile_only=true
end

task generate-quadlet image=""
  describe Generate Quadlet files for systemd integration
  containerize quadlet_only=true image=$image
end

task auto-build-with-retry
  describe Build the project with automatic retry on failures
  autobuild_retry max_retries=3
end

task auto-build-retry-robust
  describe Build with more aggressive retry settings
  autobuild_retry max_retries=5 initial_delay=2 max_delay=60
end

task ci-containerize image="" tag="latest"
  describe Full CI pipeline: build with retry, then containerize
  autobuild_retry max_retries=3
  containerize image=$image tag=$tag
end

# --
# Help Task
# --

task container-help
  describe Show help for container and quadlet commands
  shell_lang bash
  shell echo ""
  shell echo "Container and Quadlet Commands"
  shell echo "=============================="
  shell echo ""
  shell echo "AUTOMATIC CONTAINERIZATION:"
  shell echo "  pf auto-containerize          Auto-detect and containerize project"
  shell echo "  pf auto-containerize-dir      Containerize a specific directory"
  shell echo "  pf auto-containerize-hints    Containerize with dependency hints"
  shell echo "  pf generate-dockerfile        Generate Dockerfile only (no build)"
  shell echo "  pf generate-quadlet           Generate Quadlet files only"
  shell echo "  pf auto-build-with-retry      Build with automatic retry"
  shell echo "  pf auto-build-retry-robust    Build with aggressive retry settings"
  shell echo "  pf ci-containerize            Full CI: build with retry + containerize"
  shell echo ""
  shell echo "PODMAN COMPOSE:"
  shell echo "  pf compose-up                 Start API server"
  shell echo "  pf compose-down               Stop all containers"
  shell echo "  pf compose-build-wasm         Build all WASM modules"
  shell echo "  pf compose-status             Show container status"
  shell echo "  pf compose-logs               View container logs"
  shell echo "  pf compose-shell              Open shell in container"
  shell echo "  pf compose-debugger           Start debugging container"
  shell echo "  pf compose-debugger-gpu       Start GPU debugger"
  shell echo "  pf compose-clean              Remove containers and volumes"
  shell echo ""
  shell echo "QUADLET (SYSTEMD):"
  shell echo "  pf quadlet-install            Install quadlet files"
  shell echo "  pf quadlet-remove             Remove quadlet files"
  shell echo "  pf quadlet-status             Show service status"
  shell echo "  pf quadlet-reload             Reload systemd daemon"
  shell echo "  pf quadlet-start-api          Start API via systemd"
  shell echo "  pf quadlet-stop-api           Stop API via systemd"
  shell echo "  pf quadlet-logs               View service logs"
  shell echo ""
  shell echo "DEVELOPMENT:"
  shell echo "  pf dev-container              Start dev environment"
  shell echo "  pf dev-container-build        Build WASM via containers"
  shell echo "  pf dev-container-debug        Start debugger"
  shell echo "  pf dev-container-gpu          Start GPU debugger"
  shell echo ""
  shell echo "TESTING:"
  shell echo "  pf container-test             Run container infrastructure tests"
  shell echo ""
  shell echo "CONTAINERIZATION OPTIONS:"
  shell echo "  --install-hint-deps=\"...\"     Additional apt packages to install"
  shell echo "  --main-bin-hint=\"...\"         Main binary/entry point hint"
  shell echo "  --port-hint=N                 Port to expose"
  shell echo "  --base-image-hint=\"...\"       Base image to use"
  shell echo ""
  shell echo "DOCUMENTATION:"
  shell echo "  See containers/README.md for full documentation"
end
