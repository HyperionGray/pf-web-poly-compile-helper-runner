# TUI (Text User Interface) Tasks
# Interactive terminal interface for pf runner with rich library

task tui
  describe Launch interactive TUI for task management and debugging
  cd "${PFY_ROOT:-.}/pf-runner" && python3 pf_tui.py
end

task tui-with-file
  describe Launch TUI with a specific Pfyfile
  cd "${PFY_ROOT:-.}/pf-runner" && python3 pf_tui.py "${file}"
end

task install-tui-deps
  describe Install TUI dependencies (rich library)
  pip3 install --user rich || pip install --user rich
  echo "✓ TUI dependencies installed"
end

task tui-help
  describe Show TUI usage and features
  echo "🎨 pf Interactive TUI"
  echo ""
  echo "A comprehensive Text User Interface for managing pf tasks with rich library"
  echo ""
  echo "Features:"
  echo "  ✓ Task browsing organized by categories (15+ categories)"
  echo "  ✓ Interactive task execution with parameter input"
  echo "  ✓ Syntax checking for task definitions"
  echo "  ✓ Debugging tools status and information"
  echo "  ✓ Exploit development tools menu with quick actions"
  echo "  ✓ Task search functionality"
  echo "  ✓ Beautiful terminal UI with colors and tables"
  echo ""
  echo "Usage:"
  echo "  pf tui                    # Launch TUI with default Pfyfile"
  echo "  pf tui-with-file file=custom.pf  # Launch with specific file"
