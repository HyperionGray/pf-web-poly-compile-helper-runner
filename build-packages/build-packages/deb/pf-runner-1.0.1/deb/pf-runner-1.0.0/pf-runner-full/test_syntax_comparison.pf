# Simple test demonstrating new vs old syntax

task old-style
  describe Old style task with explicit shell prefix
  shell echo "Old style: line 1"
  shell echo "Old style: line 2"
  shell echo "Old style: line 3"
end

task new-style
  describe New style task with shell_lang bash
  shell_lang bash
  echo "New style: line 1"
  echo "New style: line 2"
  echo "New style: line 3"
end

task comparison
  describe Compare old vs new syntax
  shell echo "=== This uses old syntax ==="
  shell_lang bash
  echo "=== This uses new syntax ==="
  echo "Much cleaner!"
end
