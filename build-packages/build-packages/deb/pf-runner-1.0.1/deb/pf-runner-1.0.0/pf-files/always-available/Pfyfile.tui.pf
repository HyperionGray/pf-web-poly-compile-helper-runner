# TUI (Text User Interface) Tasks
# Interactive terminal interface for pf runner with rich library

task tui
  describe Launch interactive TUI for task management and debugging
  shell cd pf-runner && python3 pf_tui.py
end

task tui-with-file
  describe Launch TUI with a specific Pfyfile
  shell cd pf-runner && python3 pf_tui.py ${file}
end

task install-tui-deps
  describe Install TUI dependencies (rich library)
  shell pip3 install --user rich || pip install --user rich
  shell echo "TUI dependencies installed"
end

task tui-help
  describe Show TUI usage and features
  shell echo "pf TUI"
  shell echo ""
  shell echo "Usage:"
  shell echo "  pf --file pf-files/Pfyfile.pf tui"
  shell echo "  pf --file pf-files/Pfyfile.pf tui-with-file file=custom.pf"
  shell echo ""
  shell echo "Docs: docs/TUI.md"
end
