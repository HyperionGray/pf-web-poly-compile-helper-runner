# pf-runner internal Pfyfile
#
# Note: the repo-level tasks live at ../../pf-files/Pfyfile.pf.
# This file keeps pf-runner-specific tasks organized under pf-runner/pf-files/.

include always-on/Pfyfile.always-on-packages.pf
include always-on/Pfyfile.always-on-debug.pf
include always-on/Pfyfile.always-on-exploit.pf
include always-on/Pfyfile.always-on-security.pf
include always-on/Pfyfile.always-on-smart.pf
include always-on/Pfyfile.always-on-git.pf
include always-on/Pfyfile.always-on-os.pf
include always-on/Pfyfile.always-on-tui.pf
include always-on/Pfyfile.always-on-backup.pf

include build/Pfyfile.build-helpers.pf
include build/Pfyfile.builds.pf
include cleanup/Pfyfile.cleanup.pf
include dev/Pfyfile.dev.pf
include pasm/Pfyfile.pasm.pf
include shells/Pfyfile.shells.pf
include tests/Pfyfile.tests.pf
include web/Pfyfile.web-demo.pf

task default-task
  describe This is a task from the default Pfyfile.pf
  shell echo "Hello from the default Pfyfile.pf"
end

task install
  describe Install pf from the repo root installer
  shell cd .. && bash ./install.sh
end
