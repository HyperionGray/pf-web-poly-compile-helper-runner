name: Unit Tests

on:
  push:
    branches: [main]
    paths:
      - 'pf-runner-full/**'
      - 'tests/**'
      - 'pytest.ini'
      - '.github/workflows/unit-tests.yml'
  pull_request:
    branches: [main]
    paths:
      - 'pf-runner-full/**'
      - 'tests/**'
      - 'pytest.ini'
      - '.github/workflows/unit-tests.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  runner-unit-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    strategy:
      matrix:
        python-version: ['3.10', '3.12']

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest lark
          pip install fabric || true

      - name: Run pf-runner-full unit tests
        working-directory: pf-runner-full
        run: |
          python -m pytest tests/ -v --tb=short

      - name: Run syntax check
        working-directory: pf-runner-full
        run: |
          python -c "from pf_parser import parse_pfyfile_text; print('Parser imports OK')"
          python -c "from pf_main import PfRunner; print('Runner imports OK')"
          python -c "from pf_exceptions import PFException; print('Exceptions imports OK')"
