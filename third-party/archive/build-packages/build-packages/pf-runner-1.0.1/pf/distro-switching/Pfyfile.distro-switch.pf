# Distro Container Management Tasks
# Wrapper tasks around tools/distro-container-manager.mjs

task distro-init
  describe Initialize distro artifact directories (~/.pf/distros by default)
  shell_lang bash
  shell node tools/distro-container-manager.mjs init
end

task distro-build
  describe Build distro container images (all, or distro=<fedora|centos|arch|opensuse>)
  shell_lang bash
  shell node tools/distro-container-manager.mjs build ${distro:-}
end

task distro-install distro="" packages=""
  describe Install packages from a specific distro container
  shell_lang bash
  shell |
    set -euo pipefail
    if [ -z "${distro}" ] || [ -z "${packages}" ]; then
      echo "Usage: pf distro-install distro=<fedora|centos|arch|opensuse> packages=\"vim htop\""
      exit 1
    fi
    node tools/distro-container-manager.mjs install "${distro}" ${packages}
end

task distro-switch distro=""
  describe Switch active distro (isolated view) for PATH selection
  shell_lang bash
  shell |
    set -euo pipefail
    if [ -z "${distro}" ]; then
      echo "Usage: pf distro-switch distro=<fedora|centos|arch|opensuse>"
      exit 1
    fi
    node tools/distro-container-manager.mjs switch "${distro}"
end

task distro-view mode=""
  describe Set view mode: mode=<unified|isolated>
  shell_lang bash
  shell |
    set -euo pipefail
    if [ -z "${mode}" ]; then
      echo "Usage: pf distro-view mode=<unified|isolated>"
      exit 1
    fi
    node tools/distro-container-manager.mjs view "${mode}"
end

task distro-status
  describe Show distro container manager status
  shell_lang bash
  shell node tools/distro-container-manager.mjs status
end

task distro-cleanup artifacts="false"
  describe Remove distro container images (and optionally artifacts=true)
  shell_lang bash
  shell |
    set -euo pipefail
    if [ "${artifacts}" = "true" ]; then
      node tools/distro-container-manager.mjs cleanup --artifacts
    else
      node tools/distro-container-manager.mjs cleanup
    fi
end
