#!/bin/bash
# Post-installation script for pf-runner

set -e

# Install Python dependencies system-wide
# Note: Using --break-system-packages is safe here because this is a .deb package
# that is being installed system-wide. The dependencies are part of the package's
# contract and won't interfere with Python package manager.
# 
# Core dependencies:
# - lark (DSL parsing) - required
# - json5 (config parsing) - required  
# - fabric (SSH/remote execution) - bundled in package, not installed via pip
# 
# Note: typer and rich are listed in pyproject.toml but not used by the base runner.
# They may be used by optional components (TUI). Installing minimal dependencies only.
pip3 install --break-system-packages "lark>=1.1.0" "json5>=0.13.0" 2>/dev/null || \
pip3 install "lark>=1.1.0" "json5>=0.13.0"

# Fix permissions for build-deb.sh created package (/usr/local paths)
chmod +x /usr/local/bin/pf 2>/dev/null || true
chmod +x /usr/local/lib/pf-runner/pf_main.py 2>/dev/null || true

# Fix permissions for rules-based build (/usr paths)
chmod +x /usr/bin/pf 2>/dev/null || true
chmod +x /usr/lib/pf-runner/pf_main.py 2>/dev/null || true

echo "pf-runner installed successfully!"
echo "Run 'pf list' to get started."
