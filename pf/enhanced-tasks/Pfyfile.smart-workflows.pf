# Smart Workflows for Intelligent Tool Integration
# Basic smart workflow tasks

task smart-verify-tools
  describe Verify all tools are working correctly
  shell node "${PFY_ROOT:-.}/tools/orchestration/tool-detector.mjs" --verify --format table
end
# Smart Workflows for Integrated Security Testing
# Intelligent workflows that combine multiple tools automatically
# Reduces cognitive load from 100+ individual tasks to smart, context-aware workflows

# ============================================================================
# Core Smart Workflows - The "Just Works" Tasks
# ============================================================================

task smart-analyze
  describe Comprehensive smart analysis of any target
  shell echo "Running smart analysis on ${target}"
  shell python3 "${PFY_ROOT:-.}/tools/smart-workflows/target_detector.py" ${target} --format json > .smart_target_info.json
  shell echo "Analysis complete"
end

task smart-exploit
  describe Build an exploit workflow plan for a binary target (target=path, output=file, arch=amd64, technique=name)
  shell test -n "${target}" || (echo "[ERR] Error: target parameter required" && exit 1)
  shell python3 "${PFY_ROOT:-.}/tools/orchestration/smart_exploiter.py" "${target}" ${output:+--output ${output}} ${arch:+--arch ${arch}} ${technique:+--technique ${technique}} ${json:+--format json}
end

task checksec-unified
  describe Unified binary security analysis
  shell python3 "${PFY_ROOT:-.}/tools/smart-workflows/unified_checksec.py" ${binary} ${json:+--json}
end

task smart-help
  describe Show help for smart workflows
  shell echo "Smart Workflows Help:"
  shell echo "  pf smart-detect target=<target>    # Detect target type"
  shell echo "  pf smart-analyze target=<target>   # Analyze target"
  shell echo "  pf smart-exploit target=<target>   # Build exploit workflow"
  shell echo "  pf checksec-unified binary=<file>  # Security analysis"
end
